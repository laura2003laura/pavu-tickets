# Neon (or any PostgreSQL) connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Two long random strings (e.g. run: openssl rand -base64 32)
AUTH_SECRET="change-me"
TICKET_SECRET="change-me-too"

# Public address of the site
APP_URL="http://localhost:3000"

# Optional: Stripe (test mode). Leave empty to use simulated payment.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
